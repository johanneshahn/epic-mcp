# Node binary and JSON-RPC/REST endpoint.
# Point to an epic-server.toml anywhere on disk. Its [server] section supplies
# api_http_addr (node URL) and chain_type (mainnet | floonet | usernet).
# Network defaults to mainnet when no config is given.
EPIC_MCP_NODE_BIN=epic
EPIC_MCP_NODE_CONFIG=
# Explicit endpoint; overrides api_http_addr from NODE_CONFIG.
# Fallback: http://127.0.0.1:3413
EPIC_MCP_NODE_URL=

# Node API secret. If empty it is read from ~/.epic/<chain-home>/.api_secret
# (<chain-home> = main | floonet | usernet). Never expose this through a tool.
EPIC_MCP_API_SECRET=

# Wallet binary and password. For unattended automation the password must be
# supplied here: epic-wallet only accepts it via -p or an interactive prompt.
# NOTE: -p is visible in the process list. Run the MCP server as a dedicated
# OS user and keep this file readable only by that user (chmod 600).
EPIC_MCP_WALLET_BIN=epic-wallet
EPIC_MCP_WALLET_PASSWORD=
EPIC_MCP_WALLET_ACCOUNT=default
EPIC_MCP_WALLET_NODE_URL=

# Optional wallet directory selection (-t top_level_dir, or -c current_dir).
EPIC_MCP_WALLET_DIR=
EPIC_MCP_WALLET_CURRENT_DIR=

# Safety limits (read-only is the default).
# All state-changing tools are blocked unless EPIC_MCP_READ_ONLY=false is set explicitly.
EPIC_MCP_READ_ONLY=true
# Optional maximum amount per wallet_send/wallet_pay, in EPIC (e.g. 1000).
EPIC_MCP_MAX_SEND_AMOUNT=

# Timeouts / output limits.
EPIC_MCP_CLI_TIMEOUT_MS=60000
EPIC_MCP_HTTP_TIMEOUT_MS=20000
EPIC_MCP_MAX_OUTPUT_CHARS=60000
